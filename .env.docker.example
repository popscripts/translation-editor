# Copy this file to .env.docker and fill values.
# Full endpoint URL in the other Next.js app, e.g. https://uat.example.com/api/translations/import
UAT_TARGET_URL=

# Shared secret sent as Bearer token by this app's server-side proxy
UAT_SHARED_SECRET=

# Optional sender identifier shown in receiver logs
UAT_CLIENT_ID=json-translator
